<resources>
    <!-- Always dark: the screen sits in a car at night. Compose draws everything else. -->
    <style name="Theme.Revv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/revv_night</item>
        <item name="android:colorBackground">@color/revv_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
