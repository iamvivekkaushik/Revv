<?xml version="1.0" encoding="utf-8"?><!--
   Android's backup of Revv's settings (devices up to Android 11; data_extraction_rules.xml from 12).
   CarPlay's pairing keys and records, and Android Auto's link details (the car hotspot's password,
   the phone to wake, this head unit's Wi-Fi Direct group), stay out of it: they belong to this head
   unit alone.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="xcertplay_airplay.xml" />
    <exclude domain="sharedpref" path="diplay.xml" />
    <exclude domain="sharedpref" path="carplay_wifi_p2p.xml" />
    <exclude domain="sharedpref" path="carplay_wifi_p2p_success.xml" />
    <exclude domain="sharedpref" path="android_auto.xml" />
    <exclude domain="sharedpref" path="p2p_ownership.xml" />
</full-backup-content>
