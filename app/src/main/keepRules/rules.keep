# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# The CarPlay stack (carplay/) looks things up by name: JNI methods, enum settings saved by name,
# the BYD head-unit APIs reached by reflection. Shrink it, but keep every surviving name as it is.
-keepnames class com.shilapi.xcertplay.** { *; }
-keepclasseswithmembers class com.shilapi.xcertplay.** { native <methods>; }

# Bouncy Castle registers its algorithms by class name, which R8 cannot trace.
-keep class org.bouncycastle.** { *; }
-dontwarn org.bouncycastle.**

# JmDNS (Bonjour for wireless CarPlay) logs through SLF4J, whose optional bindings are absent.
-dontwarn org.slf4j.**

# The Android Auto stack (androidauto/): its protocol messages are protobuf classes built by
# reflection, it reads hidden Android classes by name (hotspot tethering, Wi-Fi Direct addresses)
# and settings by enum name. Shrink it, but keep every surviving name as it is.
-keepnames class com.andrerinas.openheadunit.** { *; }
-keepclasseswithmembers class com.andrerinas.openheadunit.** { native <methods>; }
-keep class com.andrerinas.openheadunit.aap.protocol.proto.** { *; }
-keep class com.google.protobuf.** { *; }
-dontwarn com.google.protobuf.**
-keepattributes Signature, InnerClasses, EnclosingMethod, *Annotation*
-keep class android.net.Network { *; }
-keep class android.net.wifi.WifiInfo { *; }
# DexMaker generates the tethering callback at run time.
-keep class com.android.dx.** { *; }
-dontwarn com.android.dx.**
