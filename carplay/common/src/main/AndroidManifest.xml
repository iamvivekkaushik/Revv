<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- The CarPlay connection runs as a foreground service so it survives Revv leaving the screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Modify system settings": Android lets an app holding it turn the Wi-Fi hotspot on (HotspotSwitch). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application>
        <service android:name="com.shilapi.xcertplay.DiPlaySessionService"
            android:exported="false" android:foregroundServiceType="connectedDevice|microphone|location" />
    </application>

</manifest>
